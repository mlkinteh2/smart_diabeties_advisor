{
  "version": 2,
  "buildCommand": "DATABASE_URL= python manage.py collectstatic --noinput",
  "outputDirectory": "staticfiles",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{**/*.ipynb,**/*.md,**/*.xlsx,**/*.csv,screenshots/**,media/**,**/test_*.py,**/debug_*.py,**/check_*.py,**/fix_*.py,**/retrain_*.py,**/run_*.py,**/create_*.py,**/refactor_*.py}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}